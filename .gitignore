# Unity
# unity_projects/ ES la raíz del proyecto de Unity (Assets/, Library/, Temp/...
# están directo adentro, no en una subcarpeta con nombre de proyecto) — por
# eso estos patrones NO llevan un "*/" extra antes de Library/Temp/etc.
unity_projects/Library/
unity_projects/Temp/
unity_projects/Obj/
unity_projects/Logs/
unity_projects/UserSettings/
unity_projects/MemoryCaptures/
unity_projects/*.csproj
unity_projects/*.sln
unity_projects/*.pidb
unity_projects/*.booproj
unity_projects/*.svd
unity_projects/*.pdb
unity_projects/*.mdb
unity_projects/*.VSCode
unity_projects/*.opendb
unity_projects/*.VC.db

# Python
python/__pycache__/
python/*/__pycache__/
python/*.pyc
python/*.pyo
python/*.pyd
python/.Python
python/venv/
python/ENV/
python/env/
python/.env
python/*.egg-info/
python/.eggs/
python/dist/
python/build/

# Audio, datos y resultados: este repo es solo el CÓDIGO del programa.
# Los estímulos generados, las grabaciones/CSV/JSON de sesiones y los
# reportes/gráficas son datos personales o regenerables, no van al repo.
audio_estimulos/
datos/
resultados/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.gitignore
