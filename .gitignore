# Unity
# unity_projects/ ES la raíz del proyecto de Unity (Assets/, Library/, Temp/...
# están directo adentro, no en una subcarpeta con nombre de proyecto) — por
# eso estos patrones NO llevan un "*/" extra antes de Library/Temp/etc.
unity_projects/Library/
unity_projects/Temp/
unity_projects/Obj/
unity_projects/Logs/
unity_projects/UserSettings/
unity_projects/MemoryCaptures/
unity_projects/*.csproj
unity_projects/*.sln
unity_projects/*.pidb
unity_projects/*.booproj
unity_projects/*.svd
unity_projects/*.pdb
unity_projects/*.mdb
unity_projects/*.VSCode
unity_projects/*.opendb
unity_projects/*.VC.db
unity_projects/.vs/

# Assets de terceros pesados (paquetes de Unity Asset Store / librerías de
# texturas) - se instalan localmente, no van al repo para no bloatearlo.
unity_projects/Assets/Fantasy Skybox FREE/
unity_projects/Assets/Fantasy Skybox FREE.meta
unity_projects/Assets/Resources/Skyboxes/
unity_projects/Assets/Resources/Skyboxes.meta
unity_projects/Assets/ALP_Assets/
unity_projects/Assets/ALP_Assets.meta
unity_projects/Assets/Free Wood Door Pack/
unity_projects/Assets/Free Wood Door Pack.meta
unity_projects/Assets/Furniture Mega Pack/
unity_projects/Assets/Furniture Mega Pack.meta

# Carpeta vacía sin usar, creada por accidente en el Editor
unity_projects/Assets/New Folder/
unity_projects/Assets/New Folder.meta

# Python
python/__pycache__/
python/*/__pycache__/
python/*.pyc
python/*.pyo
python/*.pyd
python/.Python
python/venv/
python/ENV/
python/env/
python/.env
python/*.egg-info/
python/.eggs/
python/dist/
python/build/

# Credenciales de base de datos - nunca se suben (ver .env.example)
.env

# Audio, datos y resultados: este repo es solo el CÓDIGO del programa.
# Los estímulos generados, las grabaciones/CSV/JSON de sesiones y los
# reportes/gráficas son datos personales o regenerables, no van al repo.
audio_estimulos/
datos/
resultados/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.gitignore

# Artefactos de compilación de Unity (IL2CPP/Burst): pesan >1 GB y se regeneran
# al compilar. Superan el límite de 100 MB por archivo de GitHub.
unity_projects/TesisVR_BackUpThisFolder_ButDontShipItWithYourGame/
unity_projects/TesisVR_BurstDebugInformation_DoNotShip/
unity_projects/.utmp/
